{
  "versionGroups": [
    {
      "label": "Use workspace protocol when developing local packages",
      "dependencies": [
        "$LOCAL"
      ],
      "dependencyTypes": [
        "!local"
      ],
      "pinVersion": "workspace:*"
    },
    {
      "label": "The private root package has no version",
      "dependencies": [
        "wealthsweet"
      ],
      "dependencyTypes": [
        "local"
      ],
      "isIgnored": true
    },
    {
      "label": "Peer ranges describe what consumers may install",
      "dependencyTypes": [
        "peer"
      ],
      "isIgnored": true
    }
  ]
}
