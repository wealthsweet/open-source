{
  "name": "wealthsweet",
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "prettier": "^3.9.9",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "syncpack": "15.3.3",
    "turbo": "^2.11.5",
    "turbo-ignore": "^2.11.5",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@10.34.5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wealthsweet/open-source.git"
  },
  "scripts": {
    "build": "turbo build",
    "clean": "turbo clean && rm -r .turbo pnpm-lock.yaml || true",
    "clean:full": "turbo clean:full && rm -r .turbo node_modules pnpm-lock.yaml || true",
    "deps": "syncpack list",
    "deps:fix": "syncpack fix",
    "deps:format": "syncpack format",
    "deps:list": "syncpack lint",
    "deps:update": "syncpack update",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "publish-packages": "turbo run build lint && changeset version && changeset publish",
    "release-packages": "turbo run build lint && changeset publish"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "version": ""
}
