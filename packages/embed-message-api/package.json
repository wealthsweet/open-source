{
  "name": "@wealthsweet/embed-message-api",
  "version": "1.2.0",
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tsdown": "^0.23.0",
    "typescript": "7.0.2"
  },
  "files": [
    "dist/**"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wealthsweet/open-source.git"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -r dist coverage || true",
    "clean:full": "rm -r dist coverage node_modules .turbo || true",
    "lint": "eslint . && prettier -c src/",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage.enabled",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  }
}
