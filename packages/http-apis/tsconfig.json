{
  "$schema": "https://json.schemastore.org/tsconfig",
  "include": ["."],
  "exclude": ["dist", "node_modules", "eslint.config.js"],
  "compilerOptions": {
    "skipLibCheck": true,
    "strict": true,
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ESNext"
  }
}
