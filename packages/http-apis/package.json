{
  "name": "@wealthsweet/http-apis",
  "version": "1.5.0",
  "dependencies": {
    "openapi3-ts": "^4.6.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "25.9.8",
    "eslint": "^10.11.0",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "yaml": "2.9.1",
    "zod-openapi": "5.4.6"
  },
  "exports": {
    "./performance/zod": {
      "types": "./dist/performance/zod.d.ts",
      "import": "./dist/performance/zod.js",
      "default": "./dist/performance/zod.js"
    },
    "./performance/api": {
      "types": "./dist/performance/api.d.ts",
      "import": "./dist/performance/api.js",
      "default": "./dist/performance/api.js"
    }
  },
  "files": [
    "dist/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wealthsweet/open-source.git"
  },
  "scripts": {
    "build": "pnpm gen:swagger && pnpm gen:api && tsup",
    "clean": "rm -r dist || true",
    "clean:full": "rm -r dist node_modules .turbo || true",
    "gen:api": "pnpm openapi-typescript",
    "gen:swagger": "tsx ./src/generate-swagger-files",
    "lint": "eslint",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage.enabled"
  },
  "sideEffects": false,
  "type": "module",
  "typesVersions": {
    "*": {
      "*": [
        "dist/*"
      ]
    }
  }
}
