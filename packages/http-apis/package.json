{
  "name": "@wealthsweet/http-apis",
  "version": "2.0.0",
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "eslint": "^10.11.0",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.9.9",
    "tsdown": "^0.23.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "yaml": "2.9.1",
    "zod-openapi": "6.0.2"
  },
  "exports": {
    "./performance/api": "./dist/performance/api.mjs",
    "./performance/zod": "./dist/performance/zod.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wealthsweet/open-source.git"
  },
  "scripts": {
    "build": "pnpm gen:swagger && pnpm gen:api && tsdown",
    "clean": "rm -r dist || true",
    "clean:full": "rm -r dist node_modules .turbo || true",
    "gen:api": "pnpm openapi-typescript",
    "gen:swagger": "tsx ./src/generate-swagger-files",
    "lint": "eslint",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage.enabled",
    "typecheck": "tsc --noEmit"
  },
  "sideEffects": false,
  "type": "module",
  "typesVersions": {
    "*": {
      "performance/*": [
        "./dist/performance/*.d.mts"
      ]
    }
  },
  "inlinedDependencies": {
    "zod-openapi": "6.0.2"
  }
}
